# Node dependency directory (never commit; regenerated by `npm install`)
node_modules/
.npm/

# Debug logs from package managers
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Lockfile: this project is dependency-free, so package-lock.json is trivially
# regenerable and is intentionally NOT tracked for the setup baseline.
package-lock.json

# Logs & coverage / test artifacts
*.log
coverage/
.nyc_output/

# OS / editor cruft
.DS_Store
Thumbs.db

# NOTE: src/ and tests/ are intentionally NOT ignored. Application source is
# delivered via society_mgmt_300k.zip and is expected to be tracked once the
# source-processing pipeline populates it onto this branch.

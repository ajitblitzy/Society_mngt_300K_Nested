# ---------------------------------------------------------------------------
# Society Management — Git ignore rules
#
# Node.js / Express project. These rules keep generated dependencies and
# local secrets out of version control while leaving all committed source,
# configuration, documentation, and the project archive fully tracked.
#
# Additive only: nothing here causes an existing tracked file to be ignored.
# ---------------------------------------------------------------------------

# Installed npm dependencies (regenerated by `npm install`)
node_modules/

# Local environment files — NEVER commit real secrets.
# Only the committed template `.env.example` is tracked. The patterns below
# match the real secrets file (and machine-local overrides) but intentionally
# do NOT match `.env.example`, so the template stays under version control.
.env
.env.local
.env.*.local

# npm + runtime logs
*.log
npm-debug.log*

# Jest test coverage output
coverage/

# OS-generated noise
.DS_Store

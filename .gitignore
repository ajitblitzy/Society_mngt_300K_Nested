# =============================================
# .gitignore — Node.js / Express.js Project
# =============================================

# ----- Dependencies -----
node_modules/

# ----- Environment Variables -----
# .env contains secrets and must never be committed
.env
.env.local
.env.*.local
# NOTE: .env.example is NOT ignored — it serves as documentation

# ----- Logs -----
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ----- PM2 -----
.pm2/

# ----- OS Files -----
.DS_Store
Thumbs.db

# ----- Editor / IDE Files -----
.vscode/
.idea/
*.swp
*.swo
*~

# ----- Coverage and Build -----
coverage/
dist/
.nyc_output/

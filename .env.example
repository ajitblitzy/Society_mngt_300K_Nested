# Society Management — environment configuration template
# Copy this file to `.env` and replace the placeholder values.
# NEVER commit the real `.env` file (see .gitignore).

# Secret used to sign and verify JWT access tokens.
# Use a long, random, high-entropy string in any real environment.
JWT_SECRET=change-me-to-a-long-random-secret

# Lifetime of issued JWT access tokens (zeit/ms format, e.g. 15m, 1h, 7d).
JWT_EXPIRES_IN=1h

# bcrypt cost factor (work rounds) used when hashing passwords.
# Higher = more secure but slower. 10-12 is a common range.
BCRYPT_ROUNDS=10

# Port the HTTP server listens on.
PORT=3000

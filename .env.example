# =============================================================================
# Society Management - Environment Configuration Template
# =============================================================================
# Copy this file to `.env` and replace the placeholder values below with the
# settings for your environment. These variables are loaded at startup by
# `dotenv` (see src/config/index.js) and consumed by the authentication and
# reporting features.
#
# SECURITY: The real `.env` file is git-ignored and MUST NEVER be committed
# (see .gitignore). This template intentionally contains only safe, non-secret
# placeholder/default values.
# -----------------------------------------------------------------------------

# Secret used to sign and verify JWT access tokens (jsonwebtoken).
# This is a placeholder - it MUST be overridden in the real `.env` with a long,
# random, high-entropy value (e.g. `openssl rand -hex 32`). Never reuse this
# value in any deployed environment.
JWT_SECRET=change_me_to_a_long_random_secret

# Lifetime of issued JWT access tokens, passed to jsonwebtoken's `expiresIn`.
# Accepts an ms-style duration string such as 15m, 1h, or 7d.
JWT_EXPIRES_IN=1h

# bcrypt cost factor (salt/work rounds) used by bcryptjs when hashing passwords.
# Higher values are more secure but slower; 10-12 is a common range.
BCRYPT_ROUNDS=10

# HTTP port that the server (src/server.js) binds via app.listen().
PORT=3000

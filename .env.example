# Example environment configuration for the planned JS -> Python migration target.
# Copy this file to .env and fill in real values locally. NEVER commit real secrets.
# Values are loaded via pydantic-settings (AAP Section 0.3.3 / 0.7.2); no hardcoded secrets in source.

# Database host in host:port form. Placeholder only.
DB_HOST=localhost:5432

# External/staging API key. Placeholder only -- supply the real value via your local .env or a CI secret store.
API_KEY=replace-me
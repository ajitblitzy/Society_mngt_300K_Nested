# ============================================================
# .env.example — Template for required environment variables.
#
# Project: Ajit-backprop-test (Python 3.13)
# Purpose: documents every environment variable the application
#          recognizes so that developers can produce a working
#          `.env` file by copying this template and filling in
#          their local values.
#
# Usage:
#   1. Copy this file to .env: `cp .env.example .env`
#   2. Edit .env and fill in the actual values for your environment.
#   3. NEVER commit .env to version control (.gitignore handles this).
#
# At runtime the application reads these variables from the process
# environment via `pydantic-settings` and `python-dotenv`, per AAP
# §0.7.3 (Cross-Cutting Concerns — "Configuration loading"). All
# secret values are read from `os.environ` only; nothing in the
# source tree carries real credentials (AAP §0.8.2 / §0.8.3).
#
# SECURITY: This template MUST NOT contain real secret values.
#           Every value below is an obvious placeholder. If you find
#           anything that looks like a real credential in this file,
#           treat it as a bug and report it immediately.
# ============================================================


# ============================================================
# Required — must be set before running the application.
# ============================================================

#### Database ####################################################
# DB_HOST: PostgreSQL connection URI used by Alembic migrations and
# the application's runtime data access layer.
#
# Required for `make migrate` (Python equivalent of the user's
# original `npm run migrate --db=${DB_HOST}` setup instruction —
# see AAP §0.5.1 and §0.8.3). The same URI is consumed by
# `src/ajit_backprop/db/connection.py`'s connection factory and by
# Alembic's `sqlalchemy.url` setting in `alembic.ini`.
#
# Format: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DATABASE
#   * `postgresql+psycopg`  — SQLAlchemy 2.x dialect for psycopg 3
#                             (matches `psycopg[binary]==3.2.3`
#                             pinned in requirements.txt).
#   * USER, PASSWORD        — database account credentials.
#   * HOST                  — DNS name or IP of the database server
#                             (`localhost` for local development).
#   * PORT                  — typically 5432 for PostgreSQL.
#   * DATABASE              — name of the target database.
#
# Example uses a plainly fake user/password and the loopback host so
# this template cannot be confused with a real production URI.
DB_HOST=postgresql+psycopg://user:password@localhost:5432/ajit_backprop_test

#### API Authentication ##########################################
# API_KEY: Authentication token consumed by the staging deployment.
#
# Required when deploying to staging (per the user's verbatim setup
# note "API_KEY secret required for staging" — AAP §0.9.6 / §0.9.8);
# optional during local development. The application reads this
# value via `os.getenv("API_KEY")`; if missing in a staging or
# production environment, the application surfaces a clear startup
# error rather than booting with no authentication (AAP §0.7.1
# "Hard-coded secrets" remediation rule).
#
# Generate a strong token locally with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# The placeholder below is intentionally non-functional so this
# file cannot be used as a deployable configuration on its own.
API_KEY=replace-with-staging-api-key


# ============================================================
# Optional — sensible defaults are applied if these are unset.
# ============================================================

#### Logging #####################################################
# LOG_LEVEL: Threshold for the project's `loguru`-backed logging
# subsystem (configured per AAP §0.7.3 "Logging" cross-cutting
# concern). Every translated `console.log(...)` from the original
# JavaScript becomes a `logger.info(...)` (or matching) call, so
# this knob controls verbosity globally.
#
# Valid values: DEBUG | INFO | WARNING | ERROR | CRITICAL
# Default if unset: INFO
LOG_LEVEL=INFO

#### Application #################################################
# APP_ENV: Environment selector consumed by `pydantic-settings`
# in `src/ajit_backprop/config.py`. Drives environment-specific
# defaults (e.g., stricter logging in production, looser checks in
# development) and is read by the staging-only `API_KEY` startup
# validation.
#
# Valid values: development | staging | production
# Default if unset: development
APP_ENV=development

# DEBUG: Toggles application-level debug behavior (verbose tracing,
# unmasked error responses, profiling hooks). MUST remain `false`
# in production — production debug mode leaks internal details and
# disables several safety checks.
#
# Valid values: true | false (case-insensitive; parsed by Pydantic)
# Default if unset: false
DEBUG=false

#### Database — Connection Pool ##################################
# DB_POOL_SIZE: Number of persistent connections SQLAlchemy keeps
# open to the database. Raise for high-throughput workloads; lower
# for shared / quota-limited PostgreSQL instances. Tuning this knob
# is one lever in the AAP §0.7.2 "Connection pooling" performance
# technique.
#
# Default if unset: 10
DB_POOL_SIZE=10

# DB_MAX_OVERFLOW: Additional connections SQLAlchemy will open
# beyond `DB_POOL_SIZE` when the pool is exhausted. These overflow
# connections are closed when returned to the pool rather than
# kept open, providing burst capacity without permanent overhead.
#
# Default if unset: 5
DB_MAX_OVERFLOW=5

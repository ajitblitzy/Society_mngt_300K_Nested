# ============================================================================
# Society Management API - Environment Variable Template (.env.example)
# ----------------------------------------------------------------------------
# Copy this file to ".env" and replace the placeholder values with real ones
# for your environment:
#
#     cp .env.example .env
#
# SECURITY: The real ".env" file is git-ignored and must NEVER be committed.
# Only this ".env.example" template (which contains NO real secrets) is tracked
# in version control. These variables are loaded at runtime via "dotenv".
# ============================================================================

# Secret used to sign and verify JWT access tokens.
# This is a placeholder ONLY - override it with a strong, long, random value
# in your real ".env" file (do not use this value in production).
JWT_SECRET=change_me_to_a_long_random_secret

# Access-token lifetime passed to jsonwebtoken's "expiresIn" option.
# Accepts any value the JWT library understands (e.g. 15m, 1h, 7d).
JWT_EXPIRES_IN=1h

# bcrypt cost factor (salt rounds) used by bcryptjs async password hashing.
# Higher values are more secure but slower; 10 is a sensible default.
BCRYPT_ROUNDS=10

# HTTP port that src/server.js binds via app.listen.
PORT=3000
